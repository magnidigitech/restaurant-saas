datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// 1. Platform & Tenant Entities
// ----------------------------------------------------

model PlatformUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("platform_users")
}

model Restaurant {
  id        String       @id @default(uuid())
  name      String
  subdomain String       @unique // e.g. "cafedelights" -> cafedelights.platform.com
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  // Relations
  branding      RestaurantBranding?
  domains       RestaurantDomain[]
  outlets       RestaurantOutlet[]
  memberships   RestaurantMembership[]
  modules       RestaurantModule[]
  subscriptions RestaurantSubscription[]
  auditLogs     AuditLog[]
  invitations   StaffInvitation[]
  accessGrants  AccessGrant[]
  roles         Role[]
  departments          Department[]
  designations         Designation[]
  jobGrades            JobGrade[]
  costCenters          CostCenter[]
  employees            Employee[]
  employmentRecords    EmploymentRecord[]
  outletAssignments    EmployeeOutletAssignment[]
  onboardingTemplates  OnboardingTemplate[]
  onboardings          EmployeeOnboarding[]
  fileUploads          EmployeeFileUpload[]
  inventoryCategories  InventoryCategory[]
  inventoryItems       InventoryItem[]
  stockLedger          StockLedger[]
  wastageLogs          WastageLog[]
  vendors              Vendor[]
  purchaseOrders       PurchaseOrder[]
  vendorItems          VendorItem[]
  shiftTemplates       ShiftTemplate[]
  shiftRosters         ShiftRoster[]
  shiftAssignments     ShiftAssignment[]
  shiftAvailabilities  ShiftAvailability[]
  rosterDateAvailabilities  RosterDateAvailability[]
  rosterEmployeeSubmissions RosterEmployeeSubmission[]
  shiftSwaps           ShiftSwapRequest[]
  salaryStructures     SalaryStructure[]
  payrollRuns          PayrollRun[]
  payslips             Payslip[]
  recipes              Recipe[]
  posOrders            PosOrder[]
  vaultFolders         VaultFolder[]
  vaultItems           VaultItem[]
  vaultAuditLogs       VaultAuditLog[]
  attendanceRecords    AttendanceRecord[]
  timePunches          TimePunch[]
  leaveRequests        LeaveRequest[]
  tipPoolRules         TipPoolRule[]
  tipPoolRuns          TipPoolRun[]
  financialTransactions FinancialTransaction[]
  upcomingBills        UpcomingBill[]
  checklistTemplates   ShiftChecklistTemplate[]
  checklistExecutions  ShiftChecklistExecution[]
  cateringOrders       CateringOrder[]
  cateringPackages     CateringPackage[]

  @@map("restaurants")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

model RestaurantBranding {
  id              String  @id @default(uuid())
  restaurantId    String  @unique @map("restaurant_id")
  applicationName String  @map("application_name")
  logoUrl         String? @map("logo_url")
  faviconUrl      String? @map("favicon_url")
  primaryColor    String  @default("#0f172a") @map("primary_color")
  secondaryColor  String  @default("#3b82f6") @map("secondary_color")
  loginBackground String? @map("login_background")
  supportEmail    String? @map("support_email")
  supportPhone    String? @map("support_phone")
  customDomain    String? @unique @map("custom_domain")

  // Relations
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("restaurant_branding")
}

model RestaurantDomain {
  id           String       @id @default(uuid())
  restaurantId String       @map("restaurant_id")
  domain       String       @unique // e.g. "coyotegrill.com"
  status       DomainStatus @default(PENDING)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  // Relations
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("restaurant_domains")
}

enum DomainStatus {
  PENDING
  ACTIVE
  FAILED
}

model RestaurantOutlet {
  id           String   @id @default(uuid())
  restaurantId String   @map("restaurant_id")
  name         String
  address      String?
  timezone     String   @default("UTC")
  currency     String   @default("USD")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  restaurant        Restaurant                 @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  accessGrants      AccessGrant[]
  invitations       StaffInvitation[]
  employmentRecords EmploymentRecord[]
  outletAssignments EmployeeOutletAssignment[]
  stockLedger       StockLedger[]
  wastageLogs       WastageLog[]
  purchaseOrders    PurchaseOrder[]
  shiftRosters      ShiftRoster[]
  shiftAssignments  ShiftAssignment[]
  payrollRuns          PayrollRun[]
  posOrders            PosOrder[]
  attendanceRecords    AttendanceRecord[]
  timePunches          TimePunch[]
  financialTransactions FinancialTransaction[]
  upcomingBills        UpcomingBill[]
  checklistExecutions  ShiftChecklistExecution[]
  cateringOrders       CateringOrder[]

  @@index([restaurantId])
  @@map("restaurant_outlets")
}

// ----------------------------------------------------
// 2. User & Membership Entities
// ----------------------------------------------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  tokenVersion Int      @default(0) @map("token_version")

  // Relations
  memberships              RestaurantMembership[]
  vaultProfiles            UserVaultProfile[]
  vaultItemsCreated        VaultItem[]            @relation("VaultItemAuthor")
  vaultItemSharesReceived  VaultItemShare[]       @relation("VaultShareRecipient")
  vaultAuditLogs           VaultAuditLog[]

  @@map("users")
}

model RestaurantMembership {
  id           String       @id @default(uuid())
  restaurantId String       @map("restaurant_id")
  userId       String       @map("user_id")
  employeeId   String?      @map("employee_id") // Reference to HR employee profiles
  status       MemberStatus @default(ACTIVE)
  joinedAt     DateTime     @default(now()) @map("joined_at")

  // Relations
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  employee     Employee?     @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  accessGrants AccessGrant[]

  @@unique([restaurantId, userId])
  @@index([userId])
  @@index([employeeId])
  @@map("restaurant_memberships")
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  PENDING_INVITE
}

// ----------------------------------------------------
// 3. Module & Entitlement Entities
// ----------------------------------------------------

model Module {
  id           String   @id // e.g. "inventory", "shifts", "payroll", "hr_onboarding"
  name         String
  description  String?
  status       String   @default("ACTIVE") // e.g. ACTIVE, MAINTENANCE
  sortOrder    Int      @default(0) @map("sort_order")
  dependencies String? // JSON array of module keys this depends on
  availability String   @default("GENERAL") // GENERAL, BETA, DEPRECATED
  priceMonthly Decimal  @default(0) @map("price_monthly")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  restaurants  RestaurantModule[]
  permissions  Permission[]
  accessGrants AccessGrant[]

  @@map("modules")
}

model RestaurantModule {
  id           String       @id @default(uuid())
  restaurantId String       @map("restaurant_id")
  moduleId     String       @map("module_id")
  status       ModuleStatus @default(ACTIVE)
  enabledAt    DateTime     @default(now()) @map("enabled_at")
  expiresAt    DateTime?    @map("expires_at")
  enabledBy    String?      @map("enabled_by") // PlatformUser id

  // Relations
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  module     Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, moduleId])
  @@index([moduleId])
  @@map("restaurant_modules")
}

enum ModuleStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

// ----------------------------------------------------
// 4. Role & Access Control Entities
// ----------------------------------------------------

model Role {
  id           String   @id @default(uuid())
  restaurantId String   @map("restaurant_id")
  name         String // e.g. "Store Manager", "Accountant"
  description  String?
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  restaurant   Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  accessGrants    AccessGrant[]
  invitations     StaffInvitation[]
  vaultItemShares VaultItemShare[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@map("roles")
}

model Permission {
  id          String  @id // e.g. "inventory:create_item", "payroll:approve_run"
  moduleId    String  @map("module_id")
  name        String
  description String?

  // Relations
  module Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  roles  RolePermission[]

  @@index([moduleId])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  // Relations
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model AccessGrant {
  id           String      @id @default(uuid())
  restaurantId String      @map("restaurant_id")
  membershipId String      @map("membership_id")
  moduleId     String      @map("module_id")
  roleId       String      @map("role_id")
  outletId     String?     @map("outlet_id") // Nullable if grant spans entire tenant
  status       GrantStatus @default(ACTIVE)
  createdAt    DateTime    @default(now()) @map("created_at")

  // Relations
  restaurant Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  membership RestaurantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  module     Module               @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  role       Role                 @relation(fields: [roleId], references: [id], onDelete: Cascade)
  outlet     RestaurantOutlet?    @relation(fields: [outletId], references: [id], onDelete: SetNull)

  @@index([restaurantId])
  @@index([membershipId])
  @@index([roleId])
  @@index([outletId])
  @@map("access_grants")
}

enum GrantStatus {
  ACTIVE
  REVOKED
}

// ----------------------------------------------------
// 5. Subscription & Logs & Invites
// ----------------------------------------------------

model SubscriptionPlan {
  id             String  @id @default(uuid())
  name           String // e.g. "Growth", "Enterprise"
  maxOutlets     Int     @map("max_outlets")
  maxEmployees   Int     @map("max_employees")
  maxAdminUsers  Int     @map("max_admin_users")
  storageQuotaGb Int     @map("storage_quota_gb")
  priceMonthly   Decimal @map("price_monthly")

  // Relations
  subscriptions RestaurantSubscription[]

  @@map("subscription_plans")
}

model RestaurantSubscription {
  id            String        @id @default(uuid())
  restaurantId  String        @map("restaurant_id")
  planId        String        @map("plan_id")
  status        SubStatus     @default(ACTIVE)
  billingPeriod BillingPeriod @default(MONTHLY)
  startDate     DateTime      @default(now()) @map("start_date")
  endDate       DateTime?     @map("end_date")

  // Relations
  restaurant Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  plan       SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("restaurant_subscriptions")
}

enum SubStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

enum BillingPeriod {
  MONTHLY
  ANNUALLY
}

model AuditLog {
  id             String   @id @default(uuid())
  restaurantId   String?  @map("restaurant_id") // Can be null if Platform-level event
  userId         String   @map("user_id")
  userEmail      String   @map("user_email")
  action         String // e.g. "RESTAURANT_CREATED"
  entityType     String   @map("entity_type") // e.g. "Restaurant", "User"
  entityId       String   @map("entity_id")
  previousValues String?  @map("previous_values") // JSON text of previous state
  newValues      String?  @map("new_values") // JSON text of new state
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([createdAt])
  @@map("audit_logs")
}

model StaffInvitation {
  id           String           @id @default(uuid())
  restaurantId String           @map("restaurant_id")
  email        String
  roleId       String           @map("role_id")
  outletId     String?          @map("outlet_id")
  tokenHash    String           @unique @map("token_hash")
  status       InvitationStatus @default(SENT)
  expiresAt    DateTime         @map("expires_at")
  createdAt    DateTime         @default(now()) @map("created_at")

  // Relations
  restaurant Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  role       Role              @relation(fields: [roleId], references: [id], onDelete: Cascade)
  outlet     RestaurantOutlet? @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, email])
  @@index([restaurantId])
  @@index([tokenHash])
  @@map("staff_invitations")
}

enum InvitationStatus {
  SENT
  ACCEPTED
  EXPIRED
}

// ----------------------------------------------------
// 6. Phase 2: Restaurant Master Data & Workforce Entities
// ----------------------------------------------------

model Department {
  id           String    @id @default(uuid())
  restaurantId String    @map("restaurant_id")
  name         String
  code         String
  description  String?
  status       String    @default("ACTIVE")
  archivedAt   DateTime? @map("archived_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relations
  restaurant        Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  employmentRecords  EmploymentRecord[]
  vaultItemShares    VaultItemShare[]
  checklistTemplates ShiftChecklistTemplate[]

  @@unique([restaurantId, code])
  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@map("departments")
}

model Designation {
  id           String    @id @default(uuid())
  restaurantId String    @map("restaurant_id")
  name         String
  code         String
  description  String?
  status       String    @default("ACTIVE")
  archivedAt   DateTime? @map("archived_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relations
  restaurant        Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  employmentRecords EmploymentRecord[]

  @@unique([restaurantId, code])
  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@map("designations")
}

model JobGrade {
  id           String    @id @default(uuid())
  restaurantId String    @map("restaurant_id")
  name         String
  code         String
  description  String?
  status       String    @default("ACTIVE")
  archivedAt   DateTime? @map("archived_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relations
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, code])
  @@index([restaurantId])
  @@map("job_grades")
}

model CostCenter {
  id           String    @id @default(uuid())
  restaurantId String    @map("restaurant_id")
  name         String
  code         String
  description  String?
  status       String    @default("ACTIVE")
  archivedAt   DateTime? @map("archived_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relations
  restaurant            Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  financialTransactions FinancialTransaction[]

  @@unique([restaurantId, code])
  @@index([restaurantId])
  @@map("cost_centers")
}

model Employee {
  id              String       @id @default(uuid())
  restaurantId    String       @map("restaurant_id")
  employeeCode    String       @map("employee_code")
  firstName       String       @map("first_name")
  lastName        String       @map("last_name")
  personalEmail   String?      @map("personal_email")
  phone           String?
  alternatePhone  String?      @map("alternate_phone")
  gender          String?
  dateOfBirth     DateTime?    @map("date_of_birth")
  joiningDate     DateTime     @map("joining_date")
  profilePhotoUrl String?      @map("profile_photo_url")
  workerType      WorkerType   @default(FULL_TIME) @map("worker_type")
  weeklyHoursLimit Float?      @map("weekly_hours_limit")
  kioskPin         String?      @map("kiosk_pin") // 4-digit PIN for tablet kiosk punch
  archivedAt       DateTime?    @map("archived_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  // Relations
  restaurant                Restaurant                 @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  employmentRecords         EmploymentRecord[]         @relation("EmployeeHistory")
  managedRecords            EmploymentRecord[]         @relation("ReportingManager")
  outletAssignments         EmployeeOutletAssignment[]
  emergencyContacts         EmployeeEmergencyContact[]
  documents                 EmployeeDocument[]
  memberships               RestaurantMembership[]
  onboardings               EmployeeOnboarding[]
  shiftAssignments          ShiftAssignment[]
  shiftAvailabilities       ShiftAvailability[]
  rosterDateAvailabilities  RosterDateAvailability[]
  rosterEmployeeSubmissions RosterEmployeeSubmission[]
  shiftSwapRequestsMade     ShiftSwapRequest[]         @relation("SwapRequester")
  shiftSwapRequestsReceived ShiftSwapRequest[]        @relation("SwapTarget")
  salaryStructures          SalaryStructure[]
  payslips                  Payslip[]
  attendanceRecords         AttendanceRecord[]
  timePunches               TimePunch[]
  leaveRequests             LeaveRequest[]
  assignedChecklists        ShiftChecklistExecution[]     @relation("AssignedStaff")
  verifiedChecklists        ShiftChecklistExecution[]     @relation("VerifiedBySupervisor")
  completedChecklistItems   ShiftChecklistItemExecution[] @relation("CompletedByStaff")

  @@unique([restaurantId, employeeCode])
  @@index([restaurantId])
  @@map("employees")
}

model EmploymentRecord {
  id                         String           @id @default(uuid())
  restaurantId               String           @map("restaurant_id")
  employeeId                 String           @map("employee_id")
  departmentId               String?          @map("department_id")
  designationId              String?          @map("designation_id")
  primaryOutletId            String?          @map("primary_outlet_id")
  employmentType             WorkerType?      @map("employment_type")
  effectiveFrom              DateTime         @map("effective_from")
  effectiveTo                DateTime?        @map("effective_to")
  probationEndDate           DateTime?        @map("probation_end_date")
  confirmationDate           DateTime?        @map("confirmation_date")
  noticePeriod               Int?             @map("notice_period")
  reportingManagerEmployeeId String?          @map("reporting_manager_employee_id")
  salaryStructureId          String?          @map("salary_structure_id")
  status                     EmploymentStatus @default(ACTIVE)
  notes                      String?
  createdAt                  DateTime         @default(now()) @map("created_at")
  updatedAt                  DateTime         @updatedAt @map("updated_at")

  // Relations
  restaurant       Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  employee         Employee          @relation("EmployeeHistory", fields: [employeeId], references: [id], onDelete: Cascade)
  department       Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation      Designation?      @relation(fields: [designationId], references: [id], onDelete: SetNull)
  primaryOutlet    RestaurantOutlet? @relation(fields: [primaryOutletId], references: [id], onDelete: SetNull)
  reportingManager Employee?         @relation("ReportingManager", fields: [reportingManagerEmployeeId], references: [id], onDelete: SetNull)

  @@index([restaurantId])
  @@index([employeeId])
  @@map("employment_records")
}

model EmployeeOutletAssignment {
  id             String         @id @default(uuid())
  restaurantId   String         @map("restaurant_id")
  employeeId     String         @map("employee_id")
  outletId       String         @map("outlet_id")
  isPrimary      Boolean        @default(false) @map("is_primary")
  assignmentType AssignmentType @default(PRIMARY) @map("assignment_type")
  effectiveFrom  DateTime       @default(now()) @map("effective_from")
  effectiveTo    DateTime?      @map("effective_to")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  // Relations
  restaurant Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  outlet     RestaurantOutlet @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([employeeId, outletId])
  @@index([restaurantId])
  @@index([employeeId])
  @@map("employee_outlet_assignments")
}

model EmployeeEmergencyContact {
  id           String   @id @default(uuid())
  employeeId   String   @map("employee_id")
  relationship String
  name         String
  phone        String
  address      String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_emergency_contacts")
}

model EmployeeDocument {
  id             String       @id @default(uuid())
  employeeId     String       @map("employee_id")
  type           DocumentType
  fileUrl        String?      @map("file_url")
  documentNumber String?      @map("document_number")
  issueDate      DateTime?    @map("issue_date")
  expiryDate     DateTime?    @map("expiry_date")
  verifiedBy     String?      @map("verified_by")
  verifiedAt     DateTime?    @map("verified_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  // Relations
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_documents")
}

enum EmploymentStatus {
  ACTIVE
  PROBATION
  ON_LEAVE
  NOTICE
  SUSPENDED
  TERMINATED
  RESIGNED
}

enum WorkerType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  CONSULTANT
  TEMPORARY
}

enum AssignmentType {
  PRIMARY
  TEMPORARY
  TRAINING
}

enum DocumentType {
  AADHAAR
  PASSPORT
  VISA
  CONTRACT
  RESUME
  CERTIFICATE
  MEDICAL
  FOOD_LICENSE
}

// ----------------------------------------------------
// 7. Phase 3: HR Onboarding Entities
// ----------------------------------------------------

model OnboardingTemplate {
  id           String   @id @default(uuid())
  restaurantId String   @map("restaurant_id")
  name         String
  description  String?
  isDefault    Boolean  @default(false) @map("is_default")
  archivedAt   DateTime? @map("archived_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  restaurant  Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tasks       OnboardingTask[]
  onboardings EmployeeOnboarding[]

  @@index([restaurantId])
  @@map("onboarding_templates")
}

model OnboardingTask {
  id          String   @id @default(uuid())
  templateId  String   @map("template_id")
  title       String
  description String?
  isRequired  Boolean  @default(true) @map("is_required")
  sortOrder   Int      @default(0) @map("sort_order")
  requiresDoc Boolean  @default(false) @map("requires_doc")
  taskType    TaskType @default(CHECKBOX) @map("task_type")
  fieldConfig String?  @map("field_config") // JSON string for placeholder, options, help text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  template   OnboardingTemplate      @relation(fields: [templateId], references: [id], onDelete: Cascade)
  progresses OnboardingTaskProgress[]

  @@index([templateId])
  @@map("onboarding_tasks")
}

model EmployeeOnboarding {
  id           String           @id @default(uuid())
  restaurantId String           @map("restaurant_id")
  employeeId   String           @map("employee_id")
  templateId   String           @map("template_id")
  accessToken  String           @default(dbgenerated("gen_random_uuid()")) @map("access_token")
  status       OnboardingStatus @default(PENDING)
  startedAt    DateTime?        @map("started_at")
  submittedAt  DateTime?        @map("submitted_at")
  reviewedAt   DateTime?        @map("reviewed_at")
  reviewedBy   String?          @map("reviewed_by") // User ID
  reviewNotes  String?          @map("review_notes")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  // Relations
  restaurant Restaurant              @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  employee   Employee                @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  template   OnboardingTemplate      @relation(fields: [templateId], references: [id], onDelete: Cascade)
  progresses OnboardingTaskProgress[]
  uploads    EmployeeFileUpload[]

  @@index([restaurantId])
  @@index([employeeId])
  @@index([accessToken])
  @@map("employee_onboardings")
}

model OnboardingTaskProgress {
  id           String     @id @default(uuid())
  onboardingId String     @map("onboarding_id")
  taskId       String     @map("task_id")
  status       TaskStatus @default(PENDING)
  responseValue String?   @map("response_value") // Signature data URL, text response, or date value
  completedAt  DateTime?  @map("completed_at")
  notes        String?
  fileUploadId String?    @map("file_upload_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  // Relations
  onboarding EmployeeOnboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  task       OnboardingTask     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileUpload EmployeeFileUpload? @relation(fields: [fileUploadId], references: [id], onDelete: SetNull)

  @@unique([onboardingId, taskId])
  @@index([onboardingId])
  @@map("onboarding_task_progress")
}

enum TaskType {
  CHECKBOX
  DOCUMENT
  FORM_INPUT
  SIGNATURE
  DATE
}

model EmployeeFileUpload {
  id           String       @id @default(uuid())
  restaurantId String       @map("restaurant_id")
  onboardingId String?      @map("onboarding_id")
  uploadedBy   String       @map("uploaded_by") // User ID
  fileKey      String       @map("file_key")   // e.g. "uploads/restaurantId/uuid.pdf"
  fileUrl      String       @map("file_url")
  fileName     String       @map("file_name")
  mimeType     String       @map("mime_type")
  sizeBytes    Int          @map("size_bytes")
  category     FileCategory @default(DOCUMENT)
  createdAt    DateTime     @default(now()) @map("created_at")

  // Relations
  restaurant     Restaurant               @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  onboarding     EmployeeOnboarding?      @relation(fields: [onboardingId], references: [id], onDelete: SetNull)
  taskProgresses OnboardingTaskProgress[]

  @@index([restaurantId])
  @@index([onboardingId])
  @@map("employee_file_uploads")
}

enum OnboardingStatus {
  PENDING
  IN_PROGRESS
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum TaskStatus {
  PENDING
  COMPLETED
  WAIVED
  REJECTED
}

enum FileCategory {
  DOCUMENT
  PHOTO
  CONTRACT
  OTHER
}

// ----------------------------------------------------
// 8. Phase 3: Inventory Entities
// ----------------------------------------------------

model InventoryCategory {
  id           String    @id @default(uuid())
  restaurantId String    @map("restaurant_id")
  name         String
  description  String?
  parentId     String?   @map("parent_id")
  sortOrder    Int       @default(0) @map("sort_order")
  archivedAt   DateTime? @map("archived_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relations
  restaurant Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  parent     InventoryCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children   InventoryCategory[] @relation("CategoryHierarchy")
  items      InventoryItem[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@index([parentId])
  @@map("inventory_categories")
}

model InventoryItem {
  id              String        @id @default(uuid())
  restaurantId    String        @map("restaurant_id")
  categoryId      String?       @map("category_id")
  name            String
  sku             String?
  description     String?
  unitOfMeasure   UnitOfMeasure @default(PIECES) @map("unit_of_measure")
  reorderPoint    Decimal       @default(0) @map("reorder_point")
  parLevel        Decimal       @default(0) @map("par_level")
  costPerUnit     Decimal       @default(0) @map("cost_per_unit")
  archivedAt      DateTime?     @map("archived_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  // Relations
  restaurant   Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category     InventoryCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  stockLedger  StockLedger[]
  wastageLogs  WastageLog[]
  poItems      PurchaseOrderItem[]
  vendorItems  VendorItem[]
  recipeItems  RecipeItem[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@index([categoryId])
  @@map("inventory_items")
}

model StockLedger {
  id           String            @id @default(uuid())
  restaurantId String            @map("restaurant_id")
  outletId     String            @map("outlet_id")
  itemId       String            @map("item_id")
  movementType StockMovementType @map("movement_type")
  quantity     Decimal           // positive = stock in, negative = stock out
  referenceId  String?           @map("reference_id")  // PO id, transfer id, etc.
  notes        String?
  recordedBy   String            @map("recorded_by")   // User ID
  occurredAt   DateTime          @default(now()) @map("occurred_at")
  createdAt    DateTime          @default(now()) @map("created_at")

  // Relations
  restaurant Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  outlet     RestaurantOutlet @relation(fields: [outletId], references: [id], onDelete: Cascade)
  item       InventoryItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([outletId])
  @@index([itemId])
  @@index([occurredAt])
  @@map("stock_ledger")
}

model WastageLog {
  id           String       @id @default(uuid())
  restaurantId String       @map("restaurant_id")
  outletId     String       @map("outlet_id")
  itemId       String       @map("item_id")
  quantity     Decimal
  reason       WastageReason
  notes        String?
  recordedBy   String       @map("recorded_by")
  occurredAt   DateTime     @default(now()) @map("occurred_at")
  createdAt    DateTime     @default(now()) @map("created_at")

  // Relations
  restaurant Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  outlet     RestaurantOutlet @relation(fields: [outletId], references: [id], onDelete: Cascade)
  item       InventoryItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([outletId])
  @@index([itemId])
  @@map("wastage_logs")
}

enum StockMovementType {
  PURCHASE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  CONSUMPTION
  WASTAGE
  RETURN
}

enum WastageReason {
  EXPIRED
  DAMAGED
  SPILLAGE
  THEFT
  OVERPRODUCTION
  OTHER
}

enum UnitOfMeasure {
  // Weight Units
  KG
  G
  LB
  OZ

  // Volume & Kitchen Culinary Units
  L
  ML
  GAL
  QT
  PT
  CUP
  FL_OZ
  TBSP
  TSP
  LADLE

  // Count & Portions
  PIECES
  DOZEN
  PORTION
  BOX
  PACKET
}

model Vendor {
  id            String        @id @default(uuid())
  restaurantId  String        @map("restaurant_id")
  name          String
  code          String?
  contactPerson String?       @map("contact_person")
  email         String?
  phone         String?
  address       String?
  taxId         String?       @map("tax_id")
  paymentTerms  PaymentTerms  @default(NET30) @map("payment_terms")
  status        VendorStatus  @default(ACTIVE)
  notes         String?
  archivedAt    DateTime?     @map("archived_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  // Relations
  restaurant     Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]
  vendorItems    VendorItem[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@map("inventory_vendors")
}

enum PaymentTerms {
  COD
  IMMEDIATE
  NET7
  NET15
  NET30
  NET60
}

enum VendorStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

model PurchaseOrder {
  id                   String            @id @default(uuid())
  restaurantId         String            @map("restaurant_id")
  outletId             String            @map("outlet_id")
  vendorId             String            @map("vendor_id")
  poNumber             String            @map("po_number")
  status               POStatus          @default(DRAFT)
  totalAmount          Decimal           @default(0) @map("total_amount")
  taxAmount            Decimal           @default(0) @map("tax_amount")
  grandTotal           Decimal           @default(0) @map("grand_total")
  expectedDeliveryDate DateTime?         @map("expected_delivery_date")
  notes                String?
  createdBy            String            @map("created_by")
  receivedAt           DateTime?         @map("received_at")
  archivedAt           DateTime?         @map("archived_at")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  // Relations
  restaurant Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  outlet     RestaurantOutlet  @relation(fields: [outletId], references: [id], onDelete: Cascade)
  vendor     Vendor            @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  items      PurchaseOrderItem[]

  @@unique([restaurantId, poNumber])
  @@index([restaurantId])
  @@index([outletId])
  @@index([vendorId])
  @@map("inventory_purchase_orders")
}

model PurchaseOrderItem {
  id               String   @id @default(uuid())
  purchaseOrderId  String   @map("purchase_order_id")
  itemId           String   @map("item_id")
  orderedQuantity  Decimal  @map("ordered_quantity")
  receivedQuantity Decimal  @default(0) @map("received_quantity")
  unitCost         Decimal  @map("unit_cost")
  totalCost        Decimal  @map("total_cost")

  // Relations
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  item          InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@index([itemId])
  @@map("inventory_purchase_order_items")
}

enum POStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model VendorItem {
  id           String   @id @default(uuid())
  restaurantId String   @map("restaurant_id")
  vendorId     String   @map("vendor_id")
  itemId       String   @map("item_id")
  vendorSku    String?  @map("vendor_sku")
  unitCost     Decimal? @map("unit_cost")
  leadTimeDays Int?     @map("lead_time_days")
  isPreferred  Boolean  @default(false) @map("is_preferred")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  restaurant Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  vendor     Vendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  item       InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([vendorId, itemId])
  @@index([restaurantId])
  @@index([vendorId])
  @@index([itemId])
  @@map("inventory_vendor_items")
}

