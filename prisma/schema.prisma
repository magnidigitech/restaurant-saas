// ----------------------------------------------------
// 9. Enterprise Zero-Knowledge Password & Secret Vault
// ----------------------------------------------------

enum VaultItemType {
  LOGIN
  SECURE_NOTE
  SOFTWARE_LICENSE
  API_KEY
  CREDIT_CARD
}

enum VaultSharePermission {
  READ_ONLY
  AUTOFILL_ONLY
  CAN_EDIT
  FULL_CONTROL
}

enum VaultAuditAction {
  VAULT_UNLOCKED
  ITEM_CREATED
  ITEM_VIEWED
  ITEM_COPIED_PASSWORD
  ITEM_COPIED_USERNAME
  ITEM_UPDATED
  ITEM_SHARED
  ITEM_SHARE_REVOKED
  ITEM_ARCHIVED
  ITEM_DELETED
}

model UserVaultProfile {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  masterSalt       String   @map("master_salt") // Hex/Base64 salt for PBKDF2
  keyVerifierHash  String   @map("key_verifier_hash") // Verifier to check correct master password client-side
  encryptedMasterKey String? @map("encrypted_master_key")
  publicKeyPem     String?  @map("public_key_pem") // For asymmetric team secret sharing
  encryptedPrivKey String?  @map("encrypted_priv_key")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@map("user_vault_profiles")
}

model VaultFolder {
  id           String   @id @default(uuid())
  restaurantId String   @map("restaurant_id")
  name         String
  description  String?
  icon         String?  @default("folder")
  color        String?  @default("#0071E3")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  restaurant Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items      VaultItem[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@map("vault_folders")
}

model VaultItem {
  id           String        @id @default(uuid())
  restaurantId String        @map("restaurant_id")
  authorId     String        @map("author_id")
  folderId     String?       @map("folder_id")
  title        String
  itemType     VaultItemType @default(LOGIN) @map("item_type")
  websiteUrl   String?       @map("website_url")
  
  // Zero-Knowledge Encrypted Payload
  encryptedData String       @map("encrypted_data") // Base64 ciphertext containing username, password, notes, TOTP seed, etc.
  iv            String       // Base64 Initialization Vector (12 bytes)
  authTag       String       @map("auth_tag") // Base64 GCM Auth Tag (16 bytes)
  
  isFavorite    Boolean      @default(false) @map("is_favorite")
  tags          String[]     @default([])
  archivedAt    DateTime?    @map("archived_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  // Relations
  restaurant Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  author     User             @relation("VaultItemAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  folder     VaultFolder?     @relation(fields: [folderId], references: [id], onDelete: SetNull)
  shares     VaultItemShare[]
  auditLogs  VaultAuditLog[]

  @@index([restaurantId])
  @@index([authorId])
  @@index([folderId])
  @@map("vault_items")
}

model VaultItemShare {
  id           String               @id @default(uuid())
  vaultItemId  String               @map("vault_item_id")
  recipientId  String?              @map("recipient_id")
  roleId       String?              @map("role_id")
  departmentId String?              @map("department_id")
  permission   VaultSharePermission @default(READ_ONLY)
  
  // Re-encrypted secret payload for recipient (encrypted with recipient's public key)
  encryptedKeyForRecipient String?  @map("encrypted_key_for_recipient")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  // Relations
  vaultItem    VaultItem   @relation(fields: [vaultItemId], references: [id], onDelete: Cascade)
  recipient    User?       @relation("VaultShareRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  role         Role?       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([vaultItemId])
  @@index([recipientId])
  @@index([roleId])
  @@index([departmentId])
  @@map("vault_item_shares")
}

model VaultAuditLog {
  id           String           @id @default(uuid())
  restaurantId String           @map("restaurant_id")
  userId       String           @map("user_id")
  userEmail    String           @map("user_email")
  vaultItemId  String?          @map("vault_item_id")
  action       VaultAuditAction
  details      String?
  ipAddress    String?          @map("ip_address")
  userAgent    String?          @map("user_agent")
  createdAt    DateTime         @default(now()) @map("created_at")

  // Relations
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  vaultItem  VaultItem? @relation(fields: [vaultItemId], references: [id], onDelete: SetNull)

  @@index([restaurantId])
  @@index([userId])
  @@index([vaultItemId])
  @@map("vault_audit_logs")
}

