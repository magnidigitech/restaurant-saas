  restaurant  Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  outlet      RestaurantOutlet? @relation(fields: [outletId], references: [id], onDelete: SetNull)
  payslips    Payslip[]
  tipPoolRuns TipPoolRun[]

  @@index([restaurantId])
  @@index([outletId])
  @@map("payroll_runs")
}

enum PayrollRunStatus {
  DRAFT
  CALCULATING
  APPROVED
  PAID
  CANCELLED
}

model Payslip {
  id                 String        @id @default(uuid())
  restaurantId       String        @map("restaurant_id")
  payrollRunId       String        @map("payroll_run_id")
  employeeId         String        @map("employee_id")
  periodStart        DateTime      @map("period_start")
  periodEnd          DateTime      @map("period_end")
  currency           String        @default("USD")
  hoursWorked        Decimal       @default(0) @map("hours_worked")
  overtimeHours      Decimal       @default(0) @map("overtime_hours")
  pooledTipsAmount   Decimal       @default(0) @map("pooled_tips_amount")
  timesheetSyncCount Int           @default(0) @map("timesheet_sync_count")
  basePay            Decimal       @default(0) @map("base_pay")
  totalAllowances    Decimal       @default(0) @map("total_allowances")
  totalDeductions    Decimal       @default(0) @map("total_deductions")
  netPay             Decimal       @default(0) @map("net_pay")
  status             PayslipStatus @default(DRAFT)
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  // Relations
  restaurant Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
