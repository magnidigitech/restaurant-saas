model SalaryStructure {
  id             String       @id @default(uuid())
  restaurantId   String       @map("restaurant_id")
  employeeId     String       @map("employee_id")
  payFrequency   PayFrequency @default(MONTHLY) @map("pay_frequency")
  currency       String       @default("USD")
  baseSalary     Decimal      @default(0) @map("base_salary")
  hourlyRate     Decimal      @default(0) @map("hourly_rate")
  allowancesJson String?      @map("allowances_json")
  deductionsJson String?      @map("deductions_json")
  effectiveFrom  DateTime     @default(now()) @map("effective_from")
  effectiveTo    DateTime?    @map("effective_to")
  status         String       @default("ACTIVE")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  // Relations
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([employeeId])
  @@map("payroll_salary_structures")
}

enum PayFrequency {
  MONTHLY
  BI_WEEKLY
  WEEKLY
  HOURLY
}

model PayrollRun {
  id              String           @id @default(uuid())
  restaurantId    String           @map("restaurant_id")
  outletId        String?          @map("outlet_id")
  title           String
  periodStart     DateTime         @map("period_start")
  periodEnd       DateTime         @map("period_end")
  paymentDate     DateTime         @map("payment_date")
  status          PayrollRunStatus @default(DRAFT)
  totalGross      Decimal          @default(0) @map("total_gross")
  totalAllowances Decimal          @default(0) @map("total_allowances")
  totalDeductions Decimal          @default(0) @map("total_deductions")
  totalNet        Decimal          @default(0) @map("total_net")
  processedBy     String?          @map("processed_by")
  approvedBy      String?          @map("approved_by")
  approvedAt      DateTime?        @map("approved_at")
