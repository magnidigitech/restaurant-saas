  deductions PayrollDeduction[]
  payments   PayrollPayment[]

  @@unique([payrollRunId, employeeId])
  @@index([restaurantId])
  @@index([payrollRunId])
  @@index([employeeId])
  @@map("payroll_payslips")
}

enum PayslipStatus {
  DRAFT
  GENERATED
  PAID
}

