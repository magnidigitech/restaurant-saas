enum AttendanceStatus {
  PRESENT
  LATE
  ON_BREAK
  EARLY_DEPARTURE
  HALF_DAY
  ABSENT
  ON_LEAVE
}

enum PunchType {
  CLOCK_IN
  CLOCK_OUT
  BREAK_START
  BREAK_END
}

enum LeaveType {
  CASUAL
  SICK
  ANNUAL
  UNPAID
  MATERNITY_PATERNITY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model AttendanceRecord {
  id                String           @id @default(uuid())
  restaurantId      String           @map("restaurant_id")
  employeeId        String           @map("employee_id")
  outletId          String           @map("outlet_id")
  shiftAssignmentId String?          @unique @map("shift_assignment_id")
  workDate          DateTime         @map("work_date") // Date of the work day (midnight UTC)
  status            AttendanceStatus @default(PRESENT)
  clockInTime       DateTime?        @map("clock_in_time")
  clockOutTime      DateTime?        @map("clock_out_time")
  totalWorkMinutes  Int              @default(0) @map("total_work_minutes")
  totalBreakMinutes Int              @default(0) @map("total_break_minutes")
  overtimeMinutes   Int              @default(0) @map("overtime_minutes")
  lateMinutes       Int              @default(0) @map("late_minutes")
  earlyExitMinutes  Int              @default(0) @map("early_exit_minutes")
  isApproved        Boolean          @default(false) @map("is_approved")
  approvedBy        String?          @map("approved_by")
  approvedAt        DateTime?        @map("approved_at")
  managerNotes      String?          @map("manager_notes")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  // Relations
  restaurant      Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  employee        Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  outlet          RestaurantOutlet  @relation(fields: [outletId], references: [id], onDelete: Cascade)
  shiftAssignment ShiftAssignment?  @relation(fields: [shiftAssignmentId], references: [id], onDelete: SetNull)
  timePunches     TimePunch[]

  @@unique([employeeId, workDate])
  @@index([restaurantId])
  @@index([employeeId])
  @@index([outletId])
  @@index([workDate])
  @@index([status])
  @@map("attendance_records")
}

model TimePunch {
  id                 String           @id @default(uuid())
  restaurantId       String           @map("restaurant_id")
  employeeId         String           @map("employee_id")
  outletId           String           @map("outlet_id")
  attendanceRecordId String?          @map("attendance_record_id")
  punchType          PunchType        @map("punch_type")
  punchTime          DateTime         @default(now()) @map("punch_time")
  latitude           Float?
  longitude          Float?
  ipAddress          String?          @map("ip_address")
  deviceInfo         String?          @map("device_info") // e.g. "Kitchen iPad 01" / "Web Kiosk"
  photoUrl           String?          @map("photo_url")
  notes              String?
  createdAt          DateTime         @default(now()) @map("created_at")

  // Relations
  restaurant       Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  employee         Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  outlet           RestaurantOutlet  @relation(fields: [outletId], references: [id], onDelete: Cascade)
  attendanceRecord AttendanceRecord? @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([employeeId])
  @@index([outletId])
  @@index([attendanceRecordId])
  @@index([punchTime])
  @@map("time_punches")
}

model LeaveRequest {
  id           String      @id @default(uuid())
  restaurantId String      @map("restaurant_id")
  employeeId   String      @map("employee_id")
  leaveType    LeaveType   @map("leave_type")
  startDate    DateTime    @map("start_date")
  endDate      DateTime    @map("end_date")
  totalDays    Float       @map("total_days")
  status       LeaveStatus @default(PENDING)
  reason       String
  managerNotes String?     @map("manager_notes")
  reviewedBy   String?     @map("reviewed_by")
  reviewedAt   DateTime?   @map("reviewed_at")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  // Relations
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([employeeId])
  @@index([status])
  @@index([startDate])
  @@map("leave_requests")
}

