model ShiftTemplate {
  id           String    @id @default(uuid())
  restaurantId String    @map("restaurant_id")
  name         String
  startTime    String    @map("start_time")
  endTime      String    @map("end_time")
  breakMinutes Int       @default(0) @map("break_minutes")
  color        String    @default("#3b82f6")
  status       String    @default("ACTIVE")
  archivedAt   DateTime? @map("archived_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relations
  restaurant  Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  assignments ShiftAssignment[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@map("shift_templates")
}

model ShiftRoster {
  id                   String       @id @default(uuid())
  restaurantId         String       @map("restaurant_id")
  outletId             String       @map("outlet_id")
  name                 String
  startDate            DateTime     @map("start_date")
  endDate              DateTime     @map("end_date")
  availabilityDeadline DateTime?    @map("availability_deadline")
  departments          Json?        @map("departments")
  status               RosterStatus @default(DRAFT)
  publishedAt          DateTime?    @map("published_at")
  publishedBy          String?      @map("published_by")
  notes                String?
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  // Relations
  restaurant          Restaurant                 @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  outlet              RestaurantOutlet           @relation(fields: [outletId], references: [id], onDelete: Cascade)
  assignments         ShiftAssignment[]
  dateAvailabilities  RosterDateAvailability[]
  employeeSubmissions RosterEmployeeSubmission[]

  @@index([restaurantId])
  @@index([outletId])
  @@map("shift_rosters")
}

enum RosterStatus {
  DRAFT
  AVAILABILITY_OPEN
  AVAILABILITY_LOCKED
  ASSIGNMENT_IN_PROGRESS
  PUBLISHED
  COMPLETED
  ARCHIVED
}

model ShiftAssignment {
  id           String                @id @default(uuid())
  restaurantId String                @map("restaurant_id")
  rosterId     String?               @map("roster_id")
  templateId   String?               @map("template_id")
  employeeId   String                @map("employee_id")
  outletId     String                @map("outlet_id")
  shiftDate    DateTime              @map("shift_date")
  startTime    String                @map("start_time")
  endTime      String                @map("end_time")
  breakMinutes Int                   @default(0) @map("break_minutes")
  status       ShiftAssignmentStatus @default(SCHEDULED)
  notes        String?
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  // Relations
  restaurant           Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  roster               ShiftRoster?       @relation(fields: [rosterId], references: [id], onDelete: SetNull)
  template             ShiftTemplate?     @relation(fields: [templateId], references: [id], onDelete: SetNull)
  employee             Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  outlet               RestaurantOutlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  swapRequestsMade     ShiftSwapRequest[] @relation("RequesterAssignment")
  swapRequestsTargeted ShiftSwapRequest[] @relation("TargetAssignment")
  attendanceRecord     AttendanceRecord?

  @@index([restaurantId])
  @@index([rosterId])
  @@index([employeeId])
  @@index([outletId])
  @@index([shiftDate])
  @@map("shift_assignments")
}

enum ShiftAssignmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model ShiftAvailability {
  id                 String    @id @default(uuid())
  restaurantId       String    @map("restaurant_id")
  employeeId         String    @map("employee_id")
  dayOfWeek          Int       @map("day_of_week")
  isAvailable        Boolean   @default(true) @map("is_available")
  preferredStartTime String?   @map("preferred_start_time")
  preferredEndTime   String?   @map("preferred_end_time")
  notes              String?
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  // Relations
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, dayOfWeek])
  @@index([restaurantId])
  @@index([employeeId])
  @@map("shift_availabilities")
}

enum DateAvailabilityType {
  AVAILABLE
  NOT_AVAILABLE
  SPECIFIC_TIME
  LEAVE
}

model RosterDateAvailability {
  id                 String               @id @default(uuid())
  restaurantId       String               @map("restaurant_id")
  rosterId           String               @map("roster_id")
  employeeId         String               @map("employee_id")
  date               DateTime             @map("date")
  type               DateAvailabilityType @default(AVAILABLE)
  availableFrom      String?              @map("available_from")
  availableUntil     String?              @map("available_until")
  notes              String?
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  // Relations
  restaurant Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  roster     ShiftRoster @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([rosterId, employeeId, date])
  @@index([restaurantId])
  @@index([rosterId])
  @@index([employeeId])
  @@index([date])
  @@map("roster_date_availabilities")
}

enum AvailabilitySubmissionStatus {
  DRAFT
  SUBMITTED
  LOCKED
}

model RosterEmployeeSubmission {
  id           String                       @id @default(uuid())
  restaurantId String                       @map("restaurant_id")
  rosterId     String                       @map("roster_id")
  employeeId   String                       @map("employee_id")
  status       AvailabilitySubmissionStatus @default(DRAFT)
  submittedAt  DateTime?                    @map("submitted_at")
  notes        String?
  createdAt    DateTime                     @default(now()) @map("created_at")
  updatedAt    DateTime                     @updatedAt @map("updated_at")

  // Relations
  restaurant Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  roster     ShiftRoster @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([rosterId, employeeId])
  @@index([restaurantId])
  @@index([rosterId])
  @@index([employeeId])
  @@map("roster_employee_submissions")
}

model ShiftSwapRequest {
  id                  String            @id @default(uuid())
  restaurantId        String            @map("restaurant_id")
  assignmentId        String            @map("assignment_id")
  requesterEmployeeId String            @map("requester_employee_id")
  targetEmployeeId    String?           @map("target_employee_id")
  targetAssignmentId  String?           @map("target_assignment_id")
  status              SwapRequestStatus @default(PENDING)
  reason              String?
  reviewNotes         String?           @map("review_notes")
  reviewedBy          String?           @map("reviewed_by")
  reviewedAt          DateTime?         @map("reviewed_at")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  // Relations
  restaurant          Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  requesterAssignment ShiftAssignment  @relation("RequesterAssignment", fields: [assignmentId], references: [id], onDelete: Cascade)
  targetAssignment    ShiftAssignment? @relation("TargetAssignment", fields: [targetAssignmentId], references: [id], onDelete: SetNull)
  requesterEmployee   Employee         @relation("SwapRequester", fields: [requesterEmployeeId], references: [id], onDelete: Cascade)
  targetEmployee      Employee?        @relation("SwapTarget", fields: [targetEmployeeId], references: [id], onDelete: SetNull)

  @@index([restaurantId])
  @@index([assignmentId])
  @@index([requesterEmployeeId])
  @@index([targetEmployeeId])
  @@map("shift_swap_requests")
}

enum SwapRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

