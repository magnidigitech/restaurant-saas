  FOOD_SAFETY
  WEEKLY_MAINTENANCE
  CUSTOM
}

enum ChecklistStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  VERIFIED
}

enum ItemPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model ShiftChecklistTemplate {
  id               String                 @id @default(uuid())
  restaurantId     String                 @map("restaurant_id")
  name             String
  type             ChecklistType          @default(OPENING)
  departmentId     String?                @map("department_id")
  description      String?
  estimatedMinutes Int                    @default(20) @map("estimated_minutes")
  isActive         Boolean                @default(true) @map("is_active")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  // Relations
  restaurant  Restaurant                 @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  department  Department?                @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  items       ShiftChecklistItem[]
  executions  ShiftChecklistExecution[]

  @@index([restaurantId])
  @@index([type])
  @@map("shift_checklist_templates")
}

model ShiftChecklistItem {
  id                 String                 @id @default(uuid())
  templateId         String                 @map("template_id")
  title              String
  description        String?
  roleRequired       String?                @map("role_required")
  priority           ItemPriority           @default(MEDIUM)
  requiresValueInput Boolean                @default(false) @map("requires_value_input")
  valueInputLabel    String?                @map("value_input_label")
  requiresPhoto      Boolean                @default(false) @map("requires_photo")
  sortOrder          Int                    @default(0) @map("sort_order")
  createdAt          DateTime               @default(now()) @map("created_at")

  // Relations
  template           ShiftChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  itemExecutions     ShiftChecklistItemExecution[]

  @@index([templateId])
  @@map("shift_checklist_items")
}

model ShiftChecklistExecution {
  id                   String                        @id @default(uuid())
  restaurantId         String                        @map("restaurant_id")
  outletId             String                        @map("outlet_id")
  templateId           String                        @map("template_id")
  shiftAssignmentId    String?                       @map("shift_assignment_id")
  title                String
  type                 ChecklistType                 @default(OPENING)
  executionDate        DateTime                      @map("execution_date")
  status               ChecklistStatus               @default(PENDING)
  assignedEmployeeId   String?                       @map("assigned_employee_id")
  verifiedByEmployeeId String?                       @map("verified_by_employee_id")
  verifiedAt           DateTime?                     @map("verified_at")
  notes                String?
  createdAt            DateTime                      @default(now()) @map("created_at")
  updatedAt            DateTime                      @updatedAt @map("updated_at")

  // Relations
  restaurant         Restaurant                    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  outlet             RestaurantOutlet              @relation(fields: [outletId], references: [id], onDelete: Cascade)
  template           ShiftChecklistTemplate        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  assignedEmployee   Employee?                     @relation("AssignedStaff", fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  verifiedBy         Employee?                     @relation("VerifiedBySupervisor", fields: [verifiedByEmployeeId], references: [id], onDelete: SetNull)
  items              ShiftChecklistItemExecution[]

  @@index([restaurantId])
  @@index([outletId])
  @@index([executionDate])
  @@index([status])
  @@map("shift_checklist_executions")
}

model ShiftChecklistItemExecution {
  id                    String                  @id @default(uuid())
  executionId           String                  @map("execution_id")
  templateItemId        String?                 @map("template_item_id")
  title                 String
  description           String?
  roleRequired          String?                 @map("role_required")
  priority              ItemPriority            @default(MEDIUM)
  isCompleted           Boolean                 @default(false) @map("is_completed")
  completedAt           DateTime?               @map("completed_at")
  completedByEmployeeId String?                 @map("completed_by_employee_id")
  inputValue            String?                 @map("input_value")
  photoUrl              String?                 @map("photo_url")
  notes                 String?
  sortOrder             Int                     @default(0) @map("sort_order")

  // Relations
  execution             ShiftChecklistExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  templateItem          ShiftChecklistItem?     @relation(fields: [templateItemId], references: [id], onDelete: SetNull)
  completedByEmployee   Employee?               @relation("CompletedByStaff", fields: [completedByEmployeeId], references: [id], onDelete: SetNull)

  @@index([executionId])
  @@map("shift_checklist_item_executions")
}

// ----------------------------------------------------
// 15. Catering & Event Management Engine
// ----------------------------------------------------

enum CateringEventType {
  WEDDING
  CORPORATE
  BIRTHDAY
  PRIVATE_DINING
  BUFFET
  PACKED_MEALS
  OTHER
}

enum CateringOrderStatus {
  DRAFT
  CONFIRMED
  IN_PREPARATION
  DELIVERED
  COMPLETED
  CANCELLED
}

model CateringOrder {
  id             String              @id @default(uuid())
  restaurantId   String              @map("restaurant_id")
  outletId       String?             @map("outlet_id")
  orderNumber    String              @map("order_number")
  eventName      String              @map("event_name")
  clientName     String              @map("client_name")
  clientEmail    String?             @map("client_email")
  clientPhone    String?             @map("client_phone")
  eventDate      DateTime            @map("event_date")
  eventTime      String?             @map("event_time")
  eventType      CateringEventType   @default(BUFFET) @map("event_type")
  guestCount     Int                 @default(50) @map("guest_count")
  venueAddress   String?             @map("venue_address")
  status         CateringOrderStatus @default(DRAFT)
  subtotal       Decimal             @default(0)
  taxAmount      Decimal             @default(0) @map("tax_amount")
  discountAmount Decimal             @default(0) @map("discount_amount")
  totalAmount    Decimal             @default(0) @map("total_amount")
  advancePaid    Decimal             @default(0) @map("advance_paid")
  balanceDue     Decimal             @default(0) @map("balance_due")
  notes          String?
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  // Relations
  restaurant Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  outlet     RestaurantOutlet? @relation(fields: [outletId], references: [id], onDelete: SetNull)
  items      CateringOrderItem[]

  @@unique([restaurantId, orderNumber])
  @@index([restaurantId])
  @@index([eventDate])
  @@map("catering_orders")
}

model CateringOrderItem {
  id              String   @id @default(uuid())
  cateringOrderId String   @map("catering_order_id")
  recipeId        String?  @map("recipe_id")
  itemName        String   @map("item_name")
  category        String?  @default("Main Course")
  unitPrice       Decimal  @default(0) @map("unit_price")
  quantity        Decimal  @default(1)
  totalPrice      Decimal  @default(0) @map("total_price")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  cateringOrder CateringOrder @relation(fields: [cateringOrderId], references: [id], onDelete: Cascade)
  recipe        Recipe?       @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  @@index([cateringOrderId])
  @@index([recipeId])
  @@map("catering_order_items")
}

model CateringPackage {
  id           String   @id @default(uuid())
  restaurantId String   @map("restaurant_id")
  name         String
  description  String?
  category     String?  @default("Buffet")
  pricePerPax  Decimal  @default(0) @map("price_per_pax")
  suggestedPax Int      @default(50) @map("suggested_pax")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  restaurant Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items      CateringPackageItem[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@map("catering_packages")
}

model CateringPackageItem {
  id                String   @id @default(uuid())
  cateringPackageId String   @map("catering_package_id")
  recipeId          String?  @map("recipe_id")
  itemName          String   @map("item_name")
  category          String?  @default("Main Course")
  unitPrice         Decimal  @default(0) @map("unit_price")
  portionQtyPerPax  Decimal  @default(1) @map("portion_qty_per_pax")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  cateringPackage CateringPackage @relation(fields: [cateringPackageId], references: [id], onDelete: Cascade)
  recipe          Recipe?          @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  @@index([cateringPackageId])
  @@index([recipeId])
  @@map("catering_package_items")
}








